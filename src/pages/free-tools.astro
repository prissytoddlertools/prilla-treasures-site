---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Free Toddler Tools | Prissy Toddler Tools"
  description="Free printable toddler tools and useful parent resources from Prissy Toddler Tools."
>
  <header class="page-hero">
    <p class="eyebrow">Free Tools</p>
    <h1>Try something useful first</h1>
    <p>This library will hold complete free tools with clear use notes and a working download.</p>
  </header>

  <section class="content-shell">
    <div class="notice-box">
      <h2>No free download is published yet</h2>
      <p>A free tool will appear only after the file, signup and delivery have been checked.</p>
      <p>For now, read the <a class="plain-link" href="/resources/">parent resources</a> or write to <a class="plain-link" href="mailto:founder@prillatreasures.com">founder@prillatreasures.com</a>.</p>
    </div>
  </section>
</BaseLayout>
