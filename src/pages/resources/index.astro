---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { problems } from '../../data/problems';
import { getPublishedResources } from '../../lib/content';

const resources = await getPublishedResources();
---

<BaseLayout
  title="Parent Resources | Prissy Toddler Tools"
  description="Direct parent resources for toddler routines, eating, emotions, communication, potty learning and play."
>
  <header class="page-hero">
    <p class="eyebrow">Parent Resources</p>
    <h1>Read for the moment you are in</h1>
    <p>Short articles organised by the same everyday problems as the shop.</p>
  </header>

  <section class="content-shell wide">
    <nav class="category-nav" aria-label="Resource categories">
      {problems.map((problem) => <a href={`/problems/${problem.slug}/`}>{problem.name}</a>)}
    </nav>
    {resources.length > 0 ? (
      <div class="card-grid">
        {resources.map((resource) => <ResourceCard resource={resource} />)}
      </div>
    ) : (
      <div class="notice-box">
        <h2>New parent resources are being prepared</h2>
        <p>The first articles are still in editorial review. In the meantime, browse the finished tools by the everyday problem you want to solve.</p>
        <a class="plain-link" href="/problems/">Browse by problem</a>
      </div>
    )}
  </section>
</BaseLayout>
